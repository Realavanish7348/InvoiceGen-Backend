{
  "name": "InvoiceGen API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/ready"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "var token = json && json.data && json.data.accessToken;",
                  "if (token) { pm.environment.set('accessToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@invoicegen.local\",\n  \"password\": \"Password1!\",\n  \"name\": \"Demo User\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var token = json && json.data && json.data.accessToken;",
                  "if (token) { pm.environment.set('accessToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@invoicegen.local\",\n  \"password\": \"Password1!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var token = json && json.data && json.data.accessToken;",
                  "if (token) { pm.environment.set('accessToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Business",
      "item": [
        {
          "name": "Get business profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/business-profile"
          }
        },
        {
          "name": "Create client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "pm.environment.set('clientId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"email\": \"billing@acme.test\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clients"
          }
        },
        {
          "name": "Create invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "pm.environment.set('invoiceId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"currency\": \"USD\",\n  \"issueDate\": \"2026-07-19T00:00:00.000Z\",\n  \"dueDate\": \"2026-08-02T00:00:00.000Z\",\n  \"items\": [{ \"name\": \"Consulting\", \"quantity\": 2, \"unitPrice\": 15000 }]\n}"
            },
            "url": "{{baseUrl}}/api/v1/invoices"
          }
        },
        {
          "name": "Publish invoice",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/publish"
          }
        },
        {
          "name": "Download PDF",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/pdf"
          }
        },
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/dashboard/summary"
          }
        }
      ]
    }
  ]
}
